{
  "schemaVersion": 1,
  "id": "custom.jira",
  "name": "Jira",
  "version": "0.2.0",
  "author": "Alex Weström",
  "license": "MIT",
  "description": "A Jira client inside your Omarchy shell: board, backlog, timeline, reports, development and activity, with nine languages.",
  "kinds": [
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "panel": "JiraPanel.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Jira",
    "description": "Open the Jira client window (board, backlog, summary, docs).",
    "category": "Development",
    "aliases": [
      "jira",
      "atlassian",
      "tickets"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 600,
        "step": 5,
        "defaultValue": 30
      }
    ]
  }
}
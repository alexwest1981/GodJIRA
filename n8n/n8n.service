[Unit]
Description=n8n (GodJIRA's flow in a canvas)
Documentation=https://n8nascode.dev/
After=network-online.target

[Service]
Type=simple
# install.sh writes this file and substitutes @N8N@ (the n8n it found on PATH),
# @N8N_PATH@ (its directory) and @ROOT@ (the clone the flow calls into). The
# version-and-mise paths that stood here belonged to one machine: on another, the
# service would fail with "no such file". Nothing is copied from PATH into the
# unit by hand -- the lookup happens at install time.
WorkingDirectory=%h
ExecStart=@N8N@ start
Environment=PATH=@N8N_PATH@:/usr/local/bin:/usr/bin:/bin
Environment=N8N_HOST=127.0.0.1
# n8n's own default is America/New_York: without this, a 07:30 schedule fires at 13:30.
Environment=GENERIC_TIMEZONE=Europe/Stockholm
Environment=TZ=Europe/Stockholm
Environment=N8N_LISTEN_ADDRESS=127.0.0.1
Environment=N8N_PORT=5678
Environment=N8N_SECURE_COOKIE=false
Environment=N8N_DIAGNOSTICS_ENABLED=false
# n8n v2 disables exactly two nodes by default: Execute Command and Local File
# Trigger. The flow has to run on this machine, next to the credential, so the
# command node is the point -- and this instance only listens on localhost.
Environment=NODES_EXCLUDE=[]
Environment=N8N_VERSION_NOTIFICATIONS_ENABLED=false
# The flow reads the Jira token from the session keyring; without these it answers
# "err.noTokenKeyring" (measured on the MCP server, same path). %U is this user's uid.
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
# The flow's Config node asks for the repo here instead of carrying a path of its
# own: import the workflows anywhere, and this is what they call.
Environment=GODJIRA_REPO=@ROOT@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

[Unit]
Description=n8n (GodJIRA's flow in a canvas)
Documentation=https://n8nascode.dev/
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/alex
# Node 22 (mise), not the machine's 26: n8n's own dependencies build a native
# module that has no prebuilt binary for 26, and a failed build takes the whole
# global install with it. Absolute paths, because a service gets no mise shims.
ExecStart=/home/alex/.local/share/mise/installs/node/22.23.3/bin/n8n start
Environment=PATH=/home/alex/.local/share/mise/installs/node/22.23.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=N8N_HOST=127.0.0.1
# n8n's own default is America/New_York: without this, a 07:30 schedule fires at 13:30.
Environment=GENERIC_TIMEZONE=Europe/Stockholm
Environment=TZ=Europe/Stockholm
Environment=N8N_LISTEN_ADDRESS=127.0.0.1
Environment=N8N_PORT=5678
Environment=N8N_SECURE_COOKIE=false
Environment=N8N_DIAGNOSTICS_ENABLED=false
# n8n v2 disables exactly two nodes by default: Execute Command and Local File
# Trigger. The flow has to run on this machine, next to the credential, so the
# command node is the point -- and this instance only listens on localhost.
Environment=NODES_EXCLUDE=[]
Environment=N8N_VERSION_NOTIFICATIONS_ENABLED=false
# The flow reads the Jira token from the session keyring; without these it answers
# "err.noTokenKeyring" (measured on the MCP server, same path).
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
